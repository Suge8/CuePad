// 默认是本机 ad-hoc 签名：不要开发者账号、不联网，克隆下来用 Xcode（⌘R）或 scripts/xc.sh 直接能编能跑；
// macOS 用不含 iCloud 的权限文件（受限能力在 ad-hoc 下无法启动）。本机构建打开自己的开发库（`LibraryLocation`）。
// 发布与真机构建由脚本带上团队（凭据文件的 CUEPAD_TEAM_ID，见 _signing.sh 的 team_signing）与完整权限文件；用手动签名，
// 各 target 的证书与描述文件名在工程里（描述文件由 scripts/provision.py 经 App Store Connect API 创建，
// 因为 Xcode 的自动签名用 API 密钥时管不了 App Group 与 iCloud 容器）。
CODE_SIGN_STYLE = Automatic
CODE_SIGN_IDENTITY = -
DEVELOPMENT_TEAM =

// 推送环境（只有 iOS 要推送，Mac 不收推送）：Debug 用 development，Release（描述文件是 production）在工程里覆盖为 production。
APS_ENVIRONMENT = development

// macOS 主 App 的权限文件：本机构建用不含 iCloud 的那份，发布换成完整的（team_signing）。
CUEPAD_MAC_ENTITLEMENTS = App/Config/CuePad-macOS-local.entitlements

// Hardened Runtime 是 Developer ID 公证的前提；ad-hoc 构建会被系统自动关闭它。
ENABLE_HARDENED_RUNTIME = YES
