DEFINE SCHEMA

    RECORD TYPE projects (
        "___recordID" REFERENCE QUERYABLE,
        name          ENCRYPTED STRING,
        icon          STRING,
        color         STRING,
        isPinned      INT64,
        deletedAt     INT64,
        createdAt     INT64,
        modifiedAt    INT64,
        intro         STRING,
        goalCardID    STRING,
        sortKey       STRING,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud"
    );

    RECORD TYPE cards (
        "___recordID"    REFERENCE QUERYABLE,
        projectID        STRING,
        body             ENCRYPTED STRING,
        isPinned         INT64,
        variableValues   ENCRYPTED STRING,
        sortKey          STRING,
        deletedAt        INT64,
        createdAt        INT64,
        modifiedAt       INT64,
        conflictOf       STRING,
        parentID         STRING,
        todoAt           INT64,
        startedAt        INT64,
        completedAt      INT64,
        piSessionID      STRING,
        archivedAt       INT64,
        formerSessionIDs STRING,
        cueFollows       INT64,
        isFavorite       INT64,
        numbering        STRING,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud"
    );

    RECORD TYPE sendRecords (
        "___recordID" REFERENCE QUERYABLE,
        content       ENCRYPTED STRING,
        targetKind    STRING,
        targetName    ENCRYPTED STRING,
        targetRef     ENCRYPTED STRING,
        cardID        STRING,
        sentAt        INT64,
        modifiedAt    INT64,
        deliveryID    STRING,
        origin        STRING,
        taskID        STRING,
        partIDs       STRING,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud"
    );

    RECORD TYPE attachments (
        "___recordID" REFERENCE QUERYABLE,
        hash          STRING,
        byteCount     INT64,
        format        STRING,
        createdAt     INT64,
        modifiedAt    INT64,
        file          ASSET,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud"
    );

    RECORD TYPE piSessionStates (
        "___recordID" REFERENCE QUERYABLE,
        sessionID     STRING,
        hostID        STRING,
        title         ENCRYPTED STRING,
        projectID     STRING,
        state         STRING,
        detail        ENCRYPTED STRING,
        stateSince    INT64,
        createdAt     INT64,
        modifiedAt    INT64,
        notify        STRING QUERYABLE,
        folder        ENCRYPTED STRING,
        lastPrompt    ENCRYPTED STRING,
        lastReply     ENCRYPTED STRING,
        question      ENCRYPTED STRING,
        busySince     INT64,
        launchToken   ENCRYPTED STRING,
        hosted        INT64,
        subagents     ENCRYPTED STRING,
        pendingPrompt ENCRYPTED STRING,
        model         ENCRYPTED STRING,
        thinking      ENCRYPTED STRING,
        context       ENCRYPTED STRING,
        agent         STRING,
        catalogID     STRING,
        pendingTools  ENCRYPTED STRING,
        models        ENCRYPTED STRING,
        commands      ENCRYPTED STRING,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud"
    );

    RECORD TYPE agentCatalogs (
        "___recordID" REFERENCE QUERYABLE,
        hostID        STRING,
        models        ENCRYPTED STRING,
        commands      ENCRYPTED STRING,
        modifiedAt    INT64,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud"
    );

    RECORD TYPE deliveryRequests (
        "___recordID" REFERENCE QUERYABLE,
        content       ENCRYPTED STRING,
        targetKind    STRING,
        targetName    ENCRYPTED STRING,
        targetRef     ENCRYPTED STRING,
        hostID        STRING,
        mode          STRING,
        cardID        STRING,
        status        STRING,
        resultDetail  ENCRYPTED STRING,
        handledBy     STRING,
        createdAt     INT64,
        completedAt   INT64,
        modifiedAt    INT64,
        origin        STRING,
        taskID        STRING,
        partIDs       STRING,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud"
    );

    RECORD TYPE directoryBindings (
        "___recordID" REFERENCE QUERYABLE,
        projectID     STRING,
        hostID        STRING,
        hostName      ENCRYPTED STRING,
        folder        ENCRYPTED STRING,
        createdAt     INT64,
        modifiedAt    INT64,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud"
    );

    RECORD TYPE piMessages (
        "___recordID"  REFERENCE QUERYABLE,
        sessionID      STRING,
        seq            INT64,
        role           STRING,
        text           ENCRYPTED STRING,
        at             INT64,
        tools          ENCRYPTED STRING,
        roundStartedAt INT64,
        deliveryID     STRING,
        createdAt      INT64,
        modifiedAt     INT64,
        toolCount      INT64,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud"
    );

    RECORD TYPE previews (
        "___recordID" REFERENCE QUERYABLE,
        sessionID     STRING,
        hash          STRING,
        name          ENCRYPTED STRING,
        title         ENCRYPTED STRING,
        byteCount     INT64,
        createdAt     INT64,
        modifiedAt    INT64,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud"
    );

    RECORD TYPE accountQuotas (
        "___recordID" REFERENCE QUERYABLE,
        provider      STRING,
        hostID        STRING,
        windows       ENCRYPTED STRING,
        createdAt     INT64,
        modifiedAt    INT64,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud"
    );

    RECORD TYPE cueMessages (
        "___recordID" REFERENCE QUERYABLE,
        author        STRING,
        text          ENCRYPTED STRING,
        choices       ENCRYPTED STRING,
        urgent        INT64,
        taskID        STRING,
        answer        ENCRYPTED STRING,
        answeredAt    INT64,
        deliveredAt   INT64,
        createdAt     INT64,
        modifiedAt    INT64,
        notify        STRING QUERYABLE,
        tools         ENCRYPTED STRING,
        acceptance    INT64,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud"
    );

    RECORD TYPE cueLines (
        "___recordID" REFERENCE QUERYABLE,
        text          ENCRYPTED STRING,
        pinned        INT64,
        source        STRING,
        remindAt      INT64,
        createdAt     INT64,
        modifiedAt    INT64,
        deletedAt     INT64,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud"
    );

    RECORD TYPE cueProfile (
        "___recordID" REFERENCE QUERYABLE,
        name          ENCRYPTED STRING,
        hostID        STRING,
        runtime       STRING,
        model         ENCRYPTED STRING,
        effort        ENCRYPTED STRING,
        enabledAt     INT64,
        modifiedAt    INT64,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud"
    );

    RECORD TYPE cueState (
        "___recordID" REFERENCE QUERYABLE,
        state         STRING,
        detail        ENCRYPTED STRING,
        modifiedAt    INT64,
        round         STRING,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud"
    );

    RECORD TYPE macPresence (
        "___recordID" REFERENCE QUERYABLE,
        hostID        STRING,
        onlineUntil   INT64,
        modifiedAt    INT64,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud"
    );

    RECORD TYPE tags (
        "___recordID" REFERENCE QUERYABLE,
        color         STRING,
        createdAt     INT64,
        modifiedAt    INT64,
        name          ENCRYPTED STRING,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud"
    );

    RECORD TYPE cardTags (
        "___recordID" REFERENCE QUERYABLE,
        cardID        STRING,
        createdAt     INT64,
        modifiedAt    INT64,
        tagID         STRING,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud"
    );

    RECORD TYPE probes (
        "___recordID"      REFERENCE QUERYABLE,
        kind               STRING,
        modifiedAt         INT64,
        origin             STRING,
        peerAppliedAt      INT64,
        peerFetchStartedAt INT64,
        run                STRING,
        sentAt             INT64,
        seq                INT64,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud"
    );

    RECORD TYPE tasks (
        "___recordID" REFERENCE QUERYABLE,
        content       ENCRYPTED STRING,
        projectID     STRING,
        sortKey       STRING,
        startedAt     INT64,
        completedAt   INT64,
        piSessionID   STRING,
        createdAt     INT64,
        modifiedAt    INT64,
        parentID      STRING,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud"
    );
