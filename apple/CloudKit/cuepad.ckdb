DEFINE SCHEMA

    RECORD TYPE projects (
        "___recordID" REFERENCE QUERYABLE,
        name          ENCRYPTED STRING,
        icon          STRING,
        color         STRING,
        sortKey       STRING,
        isPinned      INT64,
        deletedAt     INT64,
        createdAt     INT64,
        modifiedAt    INT64,
        goalCardID    STRING,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud"
    );

    RECORD TYPE cards (
        "___recordID"  REFERENCE QUERYABLE,
        projectID      STRING,
        body           ENCRYPTED STRING,
        numbering      STRING,
        isPinned       INT64,
        variableValues ENCRYPTED STRING,
        sortKey        STRING,
        deletedAt      INT64,
        createdAt      INT64,
        modifiedAt     INT64,
        conflictOf     STRING,
        isFavorite     INT64,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud"
    );

    RECORD TYPE tasks (
        "___recordID" REFERENCE QUERYABLE,
        content       ENCRYPTED STRING,
        projectID     STRING,
        sortKey       STRING,
        completedAt   INT64,
        piSessionID   STRING,
        createdAt     INT64,
        modifiedAt    INT64,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud"
    );

    RECORD TYPE sendRecords (
        "___recordID" REFERENCE QUERYABLE,
        content       ENCRYPTED STRING,
        targetKind    STRING,
        targetName    ENCRYPTED STRING,
        targetRef     ENCRYPTED STRING,
        cardID        STRING,
        taskID        STRING,
        sentAt        INT64,
        modifiedAt    INT64,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud"
    );

    RECORD TYPE attachments (
        "___recordID" REFERENCE QUERYABLE,
        hash          STRING,
        byteCount     INT64,
        format        STRING,
        createdAt     INT64,
        modifiedAt    INT64,
        file          ASSET,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud"
    );

    RECORD TYPE piSessionStates (
        "___recordID" REFERENCE QUERYABLE,
        sessionID     STRING,
        hostID        STRING,
        title         ENCRYPTED STRING,
        projectID     STRING,
        state         STRING,
        detail        ENCRYPTED STRING,
        stateSince    INT64,
        createdAt     INT64,
        modifiedAt    INT64,
        notify        STRING QUERYABLE,
        folder        ENCRYPTED STRING,
        lastPrompt    ENCRYPTED STRING,
        lastReply     ENCRYPTED STRING,
        question      ENCRYPTED STRING,
        busySince     INT64,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud"
    );

    RECORD TYPE deliveryRequests (
        "___recordID" REFERENCE QUERYABLE,
        content       ENCRYPTED STRING,
        targetKind    STRING,
        targetName    ENCRYPTED STRING,
        targetRef     ENCRYPTED STRING,
        hostID        STRING,
        mode          STRING,
        cardID        STRING,
        taskID        STRING,
        status        STRING,
        resultDetail  ENCRYPTED STRING,
        handledBy     STRING,
        createdAt     INT64,
        completedAt   INT64,
        modifiedAt    INT64,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud"
    );

    RECORD TYPE tags (
        "___recordID" REFERENCE QUERYABLE,
        color         STRING,
        createdAt     INT64,
        modifiedAt    INT64,
        name          ENCRYPTED STRING,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud"
    );

    RECORD TYPE cardTags (
        "___recordID" REFERENCE QUERYABLE,
        cardID        STRING,
        createdAt     INT64,
        modifiedAt    INT64,
        tagID         STRING,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud"
    );

    RECORD TYPE probes (
        "___recordID"      REFERENCE QUERYABLE,
        kind               STRING,
        modifiedAt         INT64,
        origin             STRING,
        peerAppliedAt      INT64,
        peerFetchStartedAt INT64,
        run                STRING,
        sentAt             INT64,
        seq                INT64,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud"
    );
