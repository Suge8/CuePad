#!/bin/sh
# 启用：git config core.hooksPath apple/scripts/hooks（见 xc.sh 头注释）。钩子在检出根目录运行。
# 设了 git config cuepad.mainMergeOnly true 的仓库，主检出只收合并：多个 Agent 并行时别人没提交的改动常在那里，
# 普通提交会和它们混在一起。只有一个检出的贡献者不设它。git pull 合并有冲突、解决后提交时 MERGE_HEAD 在，照常放行。
git_dir="$(git rev-parse --absolute-git-dir)"
common_dir="$(git rev-parse --path-format=absolute --git-common-dir)"
if [ "$(git config --bool cuepad.mainMergeOnly)" = true ] && [ "$git_dir" = "$common_dir" ] \
  && ! git rev-parse -q --verify MERGE_HEAD >/dev/null; then
  cat >&2 <<'EOF'
主检出只收合并，不在这里提交（这里常有别人没提交的改动）。
在自己的检出里提交，经 PR 合进主干（根目录 AGENTS.md「命令」），合并后主检出 git pull --ff-only：
  git worktree add ../CuePad-wt/<名> -b feat/<名>
EOF
  exit 1
fi
status=0
# 资料库（真实库的副本 xc.sh real copy、演示库）里是私人内容，只该在忽略掉的 .derived 里：拷进检出别处的一提交就带上了
if git diff --cached --name-only --diff-filter=AR | grep -E '(^|/)cuepad\.db(-wal|-shm)?$' >&2; then
  echo "上面是资料库文件，不入库：副本只留在 apple/.derived（apple/scripts/AGENTS.md「真实数据复现」），git rm --cached 撤掉" >&2
  status=1
fi
# 文件大小（size.py）：合并提交里是两边各自提交时已经过了这道检查的改动，不再查
git rev-parse -q --verify MERGE_HEAD >/dev/null || python3 apple/scripts/hooks/size.py || status=1
apple/scripts/lint.sh --staged || status=1
exit $status
