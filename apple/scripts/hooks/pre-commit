#!/bin/sh
# 启用：git config core.hooksPath apple/scripts/hooks（见 xc.sh 头注释）。钩子在检出根目录运行。
# 设了 git config cuepad.mainMergeOnly true 的仓库，主检出只收合并：多个 Agent 并行时别人没提交的改动常在那里，
# 普通提交会和它们混在一起。只有一个检出的贡献者不设它。合并没冲突时不经过这个钩子，有冲突、解决后提交时 MERGE_HEAD 在，照常放行。
git_dir="$(git rev-parse --absolute-git-dir)"
common_dir="$(git rev-parse --path-format=absolute --git-common-dir)"
if [ "$(git config --bool cuepad.mainMergeOnly)" = true ] && [ "$git_dir" = "$common_dir" ] \
  && ! git rev-parse -q --verify MERGE_HEAD >/dev/null; then
  cat >&2 <<'EOF'
主检出只收合并，不在这里提交（这里常有别人没提交的改动）。
在主检出里开一个自己的检出，改动在那里提交，再回主检出合并：
  git worktree add ../CuePad-wt/<名> -b feat/<名>
  cd ../CuePad-wt/<名>
  …提交…
  cd - && git merge --no-ff feat/<名>
EOF
  exit 1
fi
status=0
# 文件大小（size.py）：合并提交里是两边各自提交时已经过了这道检查的改动，不再查
git rev-parse -q --verify MERGE_HEAD >/dev/null || python3 apple/scripts/hooks/size.py || status=1
apple/scripts/lint.sh --staged || status=1
exit $status
